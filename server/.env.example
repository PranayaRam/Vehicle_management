# Server Port (Render automatically sets PORT to 10000)
PORT=5000

# MongoDB URI (Local or MongoDB Atlas cloud connection string)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vehicle_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/vehicle_management

# JWT Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Client URL (For CORS allowlisting, comma-separated if multiple)
# In production on Render: https://<your-frontend-app-name>.onrender.com
CLIENT_URL=http://localhost:5173

# Application Settings
TAX_RATE=0.18
NODE_ENV=development
